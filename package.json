{
  "name": "@astronomic-dev/search",
  "version": "0.2.3",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "description": "Fuzzy site search in a dialog for Astro and EmDash: a search index that loads on first use, a headless controller, accessible browser behavior and a default dialog.",
  "keywords": [
    "astro",
    "astro-component",
    "astro-integration",
    "withastro",
    "search",
    "site-search",
    "fuzzy-search",
    "emdash",
    "emdash-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astronomic-dev/search.git"
  },
  "homepage": "https://astronomic.dev/plugins/search",
  "bugs": {
    "url": "https://github.com/astronomic-dev/search/issues"
  },
  "files": [
    "dist/",
    "CHANGELOG.md"
  ],
  "exports": {
    "./core": "./src/core/index.ts",
    "./controller": "./src/controller/index.ts",
    "./dom": "./src/dom/index.ts",
    "./boot": "./src/browser/start.ts",
    "./ui": "./src/ui/index.ts",
    "./page": "./src/page/index.ts",
    "./results": "./src/results/index.ts",
    "./astro": "./src/astro/index.ts",
    "./astro/records-route": "./src/astro/records-route.ts",
    "./astro/SearchLink.astro": "./src/astro/SearchLink.astro",
    "./astro/SearchNoscript.astro": "./src/astro/SearchNoscript.astro",
    "./astro/SearchPage.astro": "./src/astro/SearchPage.astro",
    "./astro/virtual": {
      "types": "./src/astro/virtual.d.ts"
    },
    "./emdash": "./src/emdash/index.ts",
    "./emdash/admin": "./src/emdash/admin/index.tsx",
    "./emdash/astro": "./src/emdash/astro/index.ts",
    "./emdash/astro/SearchResults.astro": "./src/emdash/astro/SearchResults.astro",
    "./test-suite": "./test/browser/suite.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./core": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./controller": {
        "types": "./dist/controller/index.d.ts",
        "default": "./dist/controller/index.js"
      },
      "./dom": {
        "types": "./dist/dom/index.d.ts",
        "default": "./dist/dom/index.js"
      },
      "./boot": {
        "types": "./dist/browser/start.d.ts",
        "default": "./dist/browser/start.js"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/ui/index.js"
      },
      "./page": {
        "types": "./dist/page/index.d.ts",
        "default": "./dist/page/index.js"
      },
      "./results": {
        "types": "./dist/results/index.d.ts",
        "default": "./dist/results/index.js"
      },
      "./astro": {
        "types": "./dist/astro/index.d.ts",
        "default": "./dist/astro/index.js"
      },
      "./astro/records-route": {
        "types": "./dist/astro/records-route.d.ts",
        "default": "./dist/astro/records-route.js"
      },
      "./astro/SearchLink.astro": "./dist/astro/SearchLink.astro",
      "./astro/SearchNoscript.astro": "./dist/astro/SearchNoscript.astro",
      "./astro/SearchPage.astro": "./dist/astro/SearchPage.astro",
      "./astro/virtual": {
        "types": "./dist/astro/virtual.d.ts"
      },
      "./emdash": {
        "types": "./dist/emdash/index.d.ts",
        "default": "./dist/emdash/index.js"
      },
      "./emdash/admin": {
        "types": "./dist/emdash/admin/index.d.ts",
        "default": "./dist/emdash/admin/index.js"
      },
      "./emdash/astro": {
        "types": "./dist/emdash/astro/index.d.ts",
        "default": "./dist/emdash/astro/index.js"
      },
      "./emdash/astro/SearchResults.astro": "./dist/emdash/astro/SearchResults.astro"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/prepack.mjs",
    "test": "node --test --test-reporter=dot test/*.test.ts"
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "ultrahtml": "1.7.0"
  },
  "peerDependencies": {
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^7.0.0",
    "emdash": "^1.4.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/kumo": {
      "optional": true
    },
    "@phosphor-icons/react": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "emdash": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/kumo": "2.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "astro": "^7.3.5",
    "axe-core": "4.13.0",
    "emdash": "1.4.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "typescript": "6.0.3"
  }
}
